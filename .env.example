# promptFlow-AI System Configuration Example

# ----------------------------------------
# CORE SECURITY & API KEYS
# ----------------------------------------
SECRET_KEY=promptflow_ai_super_secret_jwt_key_2026
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# ----------------------------------------
# DATABASE CONNECTION (PostgreSQL Standardized)
# ----------------------------------------
DATABASE_URL=postgresql://promptflow_user:promptflow_password@localhost:5432/promptflow_database

# ----------------------------------------
# EMAIL INTEGRATION (IMAP & SMTP)
# ----------------------------------------
# Set to 'true' to start polling for incoming emails and sending alerts
EMAIL_INTEGRATION_ENABLED=false

# IMAP Polling (Retrieving incoming publication emails)
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=rajanJaiswal95064@gmail.com
# Use a Gmail App Password, NOT your main Google account password
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_POLL_INTERVAL=30

# SMTP Sending (Dispatching alerts and digests to faculty members)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ----------------------------------------
# CELERY & REDIS ASYNCHRONOUS WORKER QUEUES
# ----------------------------------------
# Set to 'true' to execute ML processing and alerts via Celery worker queues
USE_CELERY=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
